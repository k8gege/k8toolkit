/************************************************/
/* PS-PLAYER用サンプルMMLファイルです。         */
/************************************************/
T150    /* テンポ 60～182の範囲内かつ偶数で設定してください (ALS) */
        /* テンポ 60,72,84,96,108,114,126,138,150,168で設定してください (CMD/MMD) */
        /* テンポは１回のみ指定可能です。 */

{       /* 曲の始めにはカッコを付けます。 */

    'チューリップ'  /* タイトルは引用符でくくります */

    O7  /* オクターブは5(レ)～8(シ)を利用してください (ALS) */
        /* オクターブは6(ソ)～8(シ)を利用してください (CMD) */
        /* オクターブは6(ド)～8(シ)を利用してください (MMD) */

    L8  /* 音符長の初期値設定(L8 = 8分音符) */
        /* DDIP 4/3 = L12、8/3 = L24 (PHS-J80では三連符の再生はできません) */
        /* NTTD/ASTEL 4/3 = L6、8/3 = L12 */

        /* 機種により異なりますが、128音符が目安です (ALS) */
        /* ドコモとアステルでは、最大64音符までです */

    cde /* c(ド) d(レ) e(ミ) f(ファ) g(ソ) a(ラ) b(シ) */
    r   /* 休符 */
    CDE /* 大／小文字の区別はありません */
    R

    gedcded r
    cde r cde r gedcdec r
    ggegaag r eedd L4 c

}       /* 曲の終了には閉カッコを付けます。 */

{
  
  L8O6
  efg g16g16 efg g16g16 ddreer L16gfed L8
  efg g16g16 efg g16g16 reerdd L16cdef L8
  r1 L16ggrffrL8cegc>
}
